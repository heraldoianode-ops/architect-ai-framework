        { "id": 2, "name": "JWT Authentication", "estimated_days": 2 },
        { "id": 3, "name": "Core endpoints", "estimated_days": 7 },
        { "id": 4, "name": "OpenAPI documentation", "estimated_days": 2 },
        { "id": 5, "name": "Testing and security", "estimated_days": 3 },
        { "id": 6, "name": "Deploy and monitoring", "estimated_days": 2 }

{
  "usage": "Select when running INICIAR PROYECTO. Reduces initial agreement from 20min to 5min.",
  "templates": {
    "saas-web": {
      "name": "Web SaaS",
      "description": "Web SaaS application with authentication, dashboard and payments",
      "stack_defaults": { "frontend": "React 18 + Vite", "backend": "Netlify Functions", "database": "Supabase", "auth": "Supabase Auth", "hosting": "Netlify", "email": "Resend", "payments": "Stripe" },
      "typical_phases": [
        { "id": 1, "name": "Setup and Infrastructure", "estimated_days": 2 },
        { "id": 2, "name": "Authentication", "estimated_days": 3 },
        { "id": 3, "name": "Main Dashboard", "estimated_days": 5 },
        { "id": 4, "name": "Core Business Module", "estimated_days": 10 },
        { "id": 5, "name": "Payments and Subscriptions", "estimated_days": 4 },
        { "id": 6, "name": "Testing and QA", "estimated_days": 3 },
        { "id": 7, "name": "Deploy and Production", "estimated_days": 2 }

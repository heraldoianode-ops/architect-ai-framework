      "preventive_debts": [
        { "severity": "HIGH", "desc": "Input validation missing on endpoints" },
        { "severity": "HIGH", "desc": "Global rate limiting not configured" },
        { "severity": "MEDIUM", "desc": "Unstructured error logging" }
      ]
    },
    "mobile-app": {
      "name": "Mobile App",
      "stack_defaults": { "frontend": "React Native / Expo", "backend": "Supabase / custom API", "database": "Supabase", "auth": "Supabase Auth", "hosting": "App Store + Google Play", "payments": "RevenueCat / Stripe" },
